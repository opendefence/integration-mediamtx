apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: mediamtx-tls
  namespace: {{ .Values.namespace }}
spec:
  secretName: mediamtx-tls # pragma: allowlist secret
  dnsNames:
    - {{ .Values.domain | quote }}
  privateKey:
    algorithm: ECDSA
    size: 256
    rotationPolicy: Always
  issuerRef:
    name: public-issuer
    kind: ClusterIssuer
    group: cert-manager.io
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: mediamtx-config
  namespace: {{ .Values.namespace }}
data:
  mediamtx.yml: |
    authMethod: http
    authHTTPAddress: https://mediamtx-auth.{{ .Values.namespace }}.svc:9443/internal/mediamtx/auth
    authHTTPExclude: []
    authInternalUsers: []
    api: false
    metrics: false
    pprof: false
    rtspTransports: [tcp]
    rtspEncryption: strict
    rtspServerKey: /tls/tls.key
    rtspServerCert: /tls/tls.crt
    rtmpEncryption: strict
    rtmpServerKey: /tls/tls.key
    rtmpServerCert: /tls/tls.crt
    webrtcAdditionalHosts: [{{ .Values.domain | quote }}]
    moq: true
    moqServerKey: /tls/tls.key
    moqServerCert: /tls/tls.crt
    paths:
      all_others:
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mediamtx
  namespace: {{ .Values.namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: mediamtx
  template:
    metadata:
      labels:
        app.kubernetes.io/name: mediamtx
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: mediamtx
          image: docker.io/bluenviron/mediamtx:1.21.2@sha256:c7540465f868a02652118bea5a0daab12a29ac0f6cb8485abd535939ecddf886
          command: [/mediamtx, /config/mediamtx.yml]
          env:
            - name: SSL_CERT_FILE
              value: /auth-ca/ca.crt
          ports:
            - {name: hls, containerPort: 8888, protocol: TCP}
            - {name: webrtc, containerPort: 8889, protocol: TCP}
            - {name: rtsps, containerPort: 8322, protocol: TCP}
            - {name: rtmps, containerPort: 1936, protocol: TCP}
            - {name: webrtc-ice, containerPort: 8189, protocol: UDP}
            - {name: srt, containerPort: 8890, protocol: UDP}
            - {name: moq-http2, containerPort: 8892, protocol: TCP}
            - {name: moq-http3, containerPort: 8892, protocol: UDP}
            - {name: moq-quic, containerPort: 8893, protocol: UDP}
          readinessProbe:
            tcpSocket:
              port: hls
          livenessProbe:
            tcpSocket:
              port: hls
          resources:
            requests: {cpu: 100m, memory: 128Mi}
            limits: {memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          volumeMounts:
            - {name: config, mountPath: /config, readOnly: true}
            - {name: tls, mountPath: /tls, readOnly: true}
            - {name: auth-ca, mountPath: /auth-ca, readOnly: true}
      volumes:
        - name: config
          configMap:
            name: mediamtx-config
        - name: tls
          secret:
            secretName: mediamtx-tls # pragma: allowlist secret
        - name: auth-ca
          secret:
            secretName: mediamtx-auth-ca # pragma: allowlist secret
            items:
              - key: tls.crt
                path: ca.crt
---
apiVersion: v1
kind: Service
metadata:
  name: mediamtx
  namespace: {{ .Values.namespace }}
spec:
  type: ClusterIP
  selector:
    app.kubernetes.io/name: mediamtx
  ports:
    - {name: hls, port: 8888, targetPort: hls, protocol: TCP}
    - {name: webrtc, port: 8889, targetPort: webrtc, protocol: TCP}
    - {name: rtsps, port: 8322, targetPort: rtsps, protocol: TCP}
    - {name: rtmps, port: 1936, targetPort: rtmps, protocol: TCP}
    - {name: webrtc-ice, port: 8189, targetPort: webrtc-ice, protocol: UDP}
    - {name: srt, port: 8890, targetPort: srt, protocol: UDP}
    - {name: moq-http2, port: 8892, targetPort: moq-http2, protocol: TCP}
    - {name: moq-http3, port: 8892, targetPort: moq-http3, protocol: UDP}
    - {name: moq-quic, port: 8893, targetPort: moq-quic, protocol: UDP}
